[{"id":"dt-place-59cc18af-5aad-3be9-98c9-9720429f8abf","isPlace":true,"scene":"expo","city":"bayonne","category":"À voir","title":"Musée Basque et de l'histoire de Bayonne","date":null,"time":"","place":"37 quai des Corsaires Maison Dagourette, Bayonne","lat":43.49107,"lng":-1.47387,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791168335467,"description":"Le Musée Basque abrite la plus importante collection ethnographique consacrée au Pays Basque.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Bayonne_Mus%C3%A9e_Basque.JPG/960px-Bayonne_Mus%C3%A9e_Basque.JPG?utm_source=fr.wikipedia.org&utm_campaign=api&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-90a24a34-8975-3209-bc15-e17ae06f0ff1","isPlace":true,"scene":"expo","city":"bayonne","category":"À voir","title":"Eglise Saint Nicolas","date":null,"time":"","place":"Place Saint Nicolas, Capbreton","lat":43.6398564,"lng":-1.4306526,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791168335537,"description":"La très belle et néanmoins originale Eglise de Capbreton a été construite en 1539. Plusieurs fois remaniée jusqu'au XIXème siècle, l'Eglise abrite de nombreuses œuvres d'artistes Capbretonnais.  Fresques, toiles, vitraux et sculptures, elle constitue un véritable musée.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/17/Capbreton_%28Landes%29_%C3%A9glise_Saint-Nicolas.JPG/960px-Capbreton_%28Landes%29_%C3%A9glise_Saint-Nicolas.JPG?utm_source=fr.wikipedia.org&utm_campaign=api&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-58166202-6ca0-3db0-8698-c0cb24498187","isPlace":true,"scene":"village","city":"bayonne","category":"À voir","title":"L'Orangerie du Château de Bordus","date":null,"time":"","place":"1016 Route de Saint Laurent, Sainte-Marie-de-Gosse","lat":43.5487606,"lng":-1.2415792,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791168335537,"description":"Le Château de Bordus offre un écrin campagnard idéal pour un séjour inoubliable : vous souhaitez qu'une chose y revenir.\nLe Logis dispose de 11 couchages en 5 chambres par thème dans une ambiance authentique.\nUn zeste de charme à votre mesure.\nN'hésitez plus, il vous faut cette location."},{"id":"dt-place-9616df4c-f4ce-379b-b226-45531a3996da","isPlace":true,"scene":"village","city":"bayonne","category":"À voir","title":"Jardin des Barthes, un jardin remarquable","date":null,"time":"","place":"480 Chemin de Lasseougue, Saubrigues","lat":43.58727,"lng":-1.33446,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791168335537,"description":"Le JARDIN DES BARTHES classé « remarquable » est une évasion à travers les continents; de la Méditerranée à l’Asie en passant par la jungle équatoriale. Dans un cadre exceptionnel face aux Pyrénées, il met en scène sur 5ha 8 tableaux et 2500 essences"},{"id":"dt-place-8777c090-65e1-32c4-b845-8f1f2427a8a5","isPlace":true,"scene":"village","city":"bayonne","category":"À voir","title":"Le Nid de l'Orangerie du Château de Bordus","date":null,"time":"","place":"1016 Route de Saint Laurent de Gosse, Sainte-Marie-de-Gosse","lat":43.548777,"lng":-1.2415913,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791168335537,"description":"Entre le Pays Basque, les Landes et le Béarn, sur une terre de caractère, nouvellement restauré, le NID du Pays de Gosse offre un écrin idéal pour votre séjour en couple. Vous pourrez également profiter d'une pause détente avec la baignoire balnéo !"},{"id":"dt-place-aa33d80d-4dd7-30d2-8859-3dda0e2d4336","isPlace":true,"scene":"village","city":"bayonne","category":"À voir","title":"Abbaye de Lahonce","date":null,"time":"","place":"Avenue de l'Abbaye, Lahonce","lat":43.4867626,"lng":-1.3865335,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791168335537,"description":"Lieu importé depuis DataTourisme (licence ouverte, ADN Tourisme)."},{"id