0250627.jpg/960px-Orange_Arc_d%27Orange_SE_20250627.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Uoaei1, CC BY-SA 4.0","photoGeneric":true},{"id":"dt-place-fffed469-c36f-3992-897e-0958d27c1ec2","isPlace":true,"scene":"expo","city":"foix","category":"À voir","title":"Musée des Enfants du château de la Hille","date":null,"time":"","place":"Lieu dit Bourmaud, Montégut-Plantaurel","lat":43.066647,"lng":1.486001,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1792032330060,"description":"Pendant la seconde guerre mondiale, une colonie d'enfants essentiellement juifs a été un havre de paix (non sans danger...) au château de la Hille, à Montégut-Plantaurel. Ce musée situé dans la médiathèque en retrace l'histoire.","photo":"https://upload.wikimedia.org/wikipedia/commons/5/5b/MA_Treffen_La_Hille_1941_SRK_414.jpg?utm_source=fr.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled","photoCredit":"Wikimedia Commons"},{"id":"dt-place-1724bf60-e01a-3d8d-a35d-32614455d206","isPlace":true,"scene":"village","city":"foix","category":"À voir","title":"Association Moulin de la Laurède","date":null,"time":"","place":"La plaine et Mathieu, Burret","lat":42.939978,"lng":1.481572,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1792032330060,"description":"L'Association du Moulin de la Laurède organise des randonnées en partenariat avec le Parc Naturel Régional et des évènements pour tous les publics.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Monument_aux_morts_de_la_Seconde_Guerre_mondiale_%28Illhaeusern%29.jpg/960px-Monument_aux_morts_de_la_Seconde_Guerre_mondiale_%28Illhaeusern%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Gzen92, CC BY-SA 4.0","photoGeneric":true},{"id":"dt-place-e0a5ad7a-baa3-3e2a-8fda-376b0d509a32","isPlace":true,"scene":"village","city":"foix","catego