pload.wikimedia.org/wikipedia/commons/c/c1/Parc_de_la_pr%C3%A9histoire_-_Niaux_11.jpg?utm_source=fr.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled","photoCredit":"Wikimedia Commons"},{"id":"dt-place-e64e8f7e-0ed4-316b-bbfd-97c7f944780b","isPlace":true,"scene":"village","city":"foix","category":"À voir","title":"Le moulin de la Laurède","date":null,"time":"","place":"La Laurède et Bigarrat,  Hameau de Mathieu, Burret","lat":42.939984,"lng":1.481497,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1792032330060,"description":"Joli petit moulin à eau de montagne situé en pleine forêt, au cœur d'un sentier d'interprétation.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e1/Entr%C3%A9e_Institut_de_France_23_quai_de_Conti.jpg/960px-Entr%C3%A9e_Institut_de_France_23_quai_de_Conti.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Jebulon, CC0","photoGeneric":true},{"id":"dt-place-07665690-e54d-3d6d-90b3-c03967384544","isPlace":true,"scene":"village","city":"foix","category":"À voir","title":"La Grotte de Lombrives","date":null,"time":"","place":"RN 20, Ussat","lat":42.823001,"lng":1.616096,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1792032330060,"description":"Site majeur en Ariège, reconnue depuis plus de 30 ans comme la plus vaste grotte d'Europe, Lombrives est un site au poids historique et géologique incomparable. Elle renferme notamment le tombeau de Pyrène à l'origine des Pyrénées selon les mythes grecs.","photo":"https://upload.wikimedia.org/wikipedia/commons/7/72/LOMBRIVES_LE_LAC.gif?utm_source=fr.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled","photoCredit":"Wikimedia Commons"},{"id":"dt-place-f92d9d40-5a60-37d2-885e-67fb6a98826a","isPlace":true,"scene":"village","city":"foix","category":"À voir","title":"Abbaye du Pesquié","date":null,"time":"","place":"111 Chemin du Pesquié, Serres-sur-Arget","lat":42.976142,"lng":1.536282,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1792032330060,"description":"Venez rencontrer les sœurs de l'Abbaye du Pesquié et découvrir leur travail artisanal et leurs produits, notamment la Tomme du Pesquié médaillée d’or du Concours national de Tomme des Pyrénées !","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/18/Abbaye_du_Pesqui%C3%A9_%2809%29.jpg/960px-Abbaye_du_Pesqui%C3%A9_%2809%29.jpg?utm_source=fr.wikipedia.org&utm_campaign=api&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-2887a445-0253-3e2a-bb66-d9a6f1d1607a","isPlace":true,"scene":"expo","city":"foix","category":"À voir","title":"Musée du textile et du peigne en corne","date":null,"time":"","place":"6 rue Jean Canal, Lavelanet","lat":42.929675,"lng":1.845377,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1792032330060,"description":"Le musée occupe les bâtiments d'une des premières usine textile de Lavelanet qui date des années 1800 : l’usine Dumons, d’une surface totale de 3500 m2.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/77/Mus%C3%A9e_du_textile%2C_Lavelanet_%281%29.jpg/960px-Mus%C3%A9e_du_textile%2C_Lavelanet_%281%29.jpg?utm_source=fr.wikipedia.org&utm_campaign=api&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-499f091c-e309-3393-a4d5-4fb5ffcea57e","isPlace":true,"scene":"expo","city":"foix","category":"À voir","title":"Musée de la Magie","date":null,"time":"","place":"20, rue de la République, Pamiers","lat":43.115671,"lng":1.611736,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1792032330060,"description":"Réussirez-vous à percer les secrets des magiciens ?! À Pamiers, il existe un lieu fantastique, aux milles secrets où l’histoire et l’émerveillement vous attendent. Entrez et découvrez le monde fascinant des magiciens au Musée de la Magie !","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/63/Sal