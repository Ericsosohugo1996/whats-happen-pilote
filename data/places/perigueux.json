[{"id":"dt-place-ba1ba9a0-0dbd-39de-b6cd-efc6574efc37","isPlace":true,"scene":"expo","city":"perigueux","category":"À voir","title":"Ecomusée de la Truffe","date":null,"time":"","place":"2 route des Truffières 2, route des truffières, Sorges et Ligueux en Périgord","lat":45.3057007,"lng":0.87333261,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791168335537,"description":"À Sorges, sur la RN21, au rond point , dans une belle ferme restaurée du XVIIIe siècle, l’Ecomusée vous accueille pour vous dévoiler tous les mystères du diamant noir : espèces, histoire, cycle, culture, gastronomie. Découvrez également le sentier des truffières et observez la flore du causse."},{"id":"dt-place-54af7661-22ae-38c2-9bf4-1b11208e5e1f","isPlace":true,"scene":"village","city":"perigueux","category":"À voir","title":"Eglise St Front de Bruc","date":null,"time":"","place":"Bruc, Grignols","lat":45.0866471,"lng":0.54690374,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791168335537,"description":"Lieu importé depuis DataTourisme (licence ouverte, ADN Tourisme).","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f5/Grignols_%C3%A9glise_Bruc_%2810%29.JPG/960px-Grignols_%C3%A9glise_Bruc_%2810%29.JPG?utm_source=fr.wikipedia.org&utm_campaign=api&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-2c63ed29-39e5-3579-a85d-9351ac77ba0c","isPlace":true,"scene":"village","city":"perigueux","category":"À voir","title":"Château de Fayolle","date":null,"time":"","place":"Route du château, Tocane-Saint-Apre","lat":45.22917,"lng":0.49972,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791168335537,"description":"Niché dans un écrin de verdure de 55 hectares, le château de Fayolle est situé sur la commune de Tocane-Saint-Apre, à 20 minutes de Périgueux en Dordogne.\nCette majestueuse demeure s’apprête à retrouver toute sa splendeur d’antan...","photo":"https://thumb.wikimedia.org/wikipedia/commo