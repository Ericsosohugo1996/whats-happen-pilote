thumb/5/5c/Hermitage_Museum_-_2015_Dec_-_IMG_1980_%28r297%29.jpg/960px-Hermitage_Museum_-_2015_Dec_-_IMG_1980_%28r297%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Poudou99, CC BY-SA 4.0","photoGeneric":true},{"id":"dt-place-6d44a994-45f1-3b28-9592-1648a215eab6","isPlace":true,"scene":"village","city":"bourges","category":"À voir","title":"Au puits de l'abbaye","date":null,"time":"","place":"11 Place Saint-Bonnet, Bourges","lat":47.086658,"lng":2.399512,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1792032330060,"description":"Au puits de l'abbaye - centre historique de Bourges","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/27/Cathedral_of_St._Lazare%2C_Autun%2C_France_--_Relief_sculpture_-_Vanderbilt_ACT_-_Autun21.jpg/960px-Cathedral_of_St._Lazare%2C_Autun%2C_France_--_Relief_sculpture_-_Vanderbilt_ACT_-_Autun21.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Anne C. Richardson, Jim Womack, Public domain","photoGeneric":true},{"id":"dt-place-846f1c5b-7375-3705-80f5-532a04070471","isPlace":true,"scene":"expo","city":"bourges","category":"À voir","title":"Musée du Berry","date":null,"time":"","place":"4 rue des arènes, Bourges","lat":47.0854578,"lng":2.393154,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1792032330060,"description":"Le musée du Berry est un hôtel particulier du début du 16ème siècle. Il a été la résidence du célèbre juriste Jacques Cujas entre 1585 et 1590. Ce musée est consacré à l'histoire, à l'archéologie et aux Beaux-Arts.  Le musée est fermé pour rénovation.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/Bourges_-_H%C3%B4tel_Cujas_-736.jpg/960px-Bourges_-_H%C3%B4tel_Cujas_-736.jpg?utm_source=fr.wikipedia.org&utm_campaign=api&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-e34663b6-8805-3604-89b3-15ef991c0495","isPlace":true,"scene":"village","city":"bourges","category":"À voir","title":"Château du Sollier","date":null,"time":"","place":"Route du Sollier, Le Subdray","lat":47.0198421,"lng":2.289455,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1792032330060,"description":"Un château d’exception au cœur des émotions, tout près de Bourges.\nIci, chaque pas raconte une histoire. Entre les parquets, les moulures, les meubles anciens et la lumière qui révèle chaque détail, le Château du Sollier offre une parenthèse rare : authentique, paisible, accueillante par nature.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d7/Side_view_of_the_Ch%C3%A2teau_de_Chantilly_with_water_reflection_and_blue_sky_Oise_France.jpg/960px-Side_view_of_the_Ch%C3%A2teau_de_Chantilly_with_water_reflection_and_blue_sky_Oise_France.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Basile Morin, CC BY-SA 4.0","photoGeneric":true},{"id":"dt-place-a50ccef1-0414-3a6b-9d23-53febbedda0f","isPlace":true,"scene":"expo","city":"bourges","category":"À voir","title":"Parc du Château de Maubranche","date":null,"time":"","place":"La Grande Pièce, Moulins-sur-Yèvre","lat":47.1088725,"lng":2.53941899,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1792032330060,"description":"Le château de Maubranche a été construit en 1450 par un Ecossais qui était chef de la garde écossaise de Louis XI. \nAu XIX ème siècle est intervenu le célèbre architecte Paul Emile Sanson qui a construit la conciergerie, les écuries, la basse cour, le potager ainsi qu'une galerie gothique.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/31/Chateau_de_Tallard_%28Hautes-Alpes%2C_France%29_DSC01196.jpg/960px-Chateau_de_Tallard_%28Hautes-Alpes%2C_France%29_DSC01196.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Pline, CC BY-SA 4.0","photoGeneric":true},{"id":"dt-place-2dbd9913-2e11-3474-8852-45d30152712a","isPlace":true,"scene":"expo","city":"bourges","category":"À voir","title":"Galerie du Phare","date":null,"time":"","place":"6 bis rue Henri Ducrot, Bourges","lat":47.0813488,"lng":2.39589739,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1792032330060,"description":"Située à Bourges, à proximité du Palais ducal Jean de Berry, la Galerie du Phare est un espace intimiste, dédié à l’Art, qui contribue à la diversité  culturelle de la cité berruyère par ses  expositions régulières, complétées depuis peu, par un pôle éditorial.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4d/Vernet-Battle_of_Hanau.jpg/960px-Vernet-Battle_of_Hanau.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Horace Vernet, Public domain","photoGeneric":true},{"id":"dt-place-543c3c10-1c8f-3911-bbcc-b2fd17658431","isPlace":true,"scene":"expo","city":"bourges","category":"À voir","title":"Galerie d'Art Laramée","date":null,"time":"","place":"19 rue Coursalon, Bourges","lat":47.085034,"lng":2.39714,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1792032330060,"description":"Tableaux contemporains, street art et moderne, artistes présents Chanoir, Onemizer, Leslie Berthet Laval, Daniel Castan, Christof Monnin, hank China... sculptures contemporaines, Nathalie Laudon, bronze Art déco, meuble Art déco, meubles vintage, fauteuils club, tapis contemporain.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e3/Gallery_installation_view_%E2%80%93_Contemporary_Art_BASEL_2021_04.jpg/960px-Gallery_installation_view_%E2%80%93_Contemporary_Art_BASEL_2021_04.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · HonysTorresArt, CC BY-SA 4.0","photoGeneric":true},{"id":"dt-place-82221afe-549c-3921-8210-b319242131ef","isPlace":true,"scene":"villa