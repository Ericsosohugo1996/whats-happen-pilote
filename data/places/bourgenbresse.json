[{"id":"dt-place-457fed7c-22aa-33bb-b9aa-1308605c0479","isPlace":true,"scene":"expo","city":"bourgenbresse","category":"À voir","title":"Écomusée Maison de Pays en Bresse","date":null,"time":"","place":"100 route de Bourg lieu dit Montaplan, Saint-Étienne-du-Bois","lat":46.28394,"lng":5.288823,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"L’Écomusée Maison de Pays en Bresse vous permet de voyager dans le temps et de découvrir la Bresse du XVe au XIXe siècle.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/62/Saint-Etienne_du_bois_Ferme_des_Mangettes.jpg/960px-Saint-Etienne_du_bois_Ferme_des_Mangettes.jpg?utm_source=fr.wikipedia.org&utm_campaign=api&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-e91df149-72a7-37a8-8836-95787e843413","isPlace":true,"scene":"village","city":"bourgenbresse","category":"À voir","title":"Eglise de Pressiat","date":null,"time":"","place":"Place de l'église, Val-Revermont","lat":46.323638,"lng":5.385146,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"Eglise du 12e siècle / peintures du 15e siècle. \r\nCes images édifiantes à l’usage de fidèles illettrés sont exceptionnelles. On y reconnaît le jugement dernier, avec la résurrection des morts et la pesée des âmes. Clef à retirer à l’Auberge du Mont Myon.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b3/%C3%89glise_St_Laurent_Pressiat_Val_Revermont_1.jpg/960px-%C3%89glise_St_Laurent_Pressiat_Val_Revermont_1.jpg?utm_source=fr.wikipedia.org&utm_campaign=api&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-063f6668-e836-393c-97a3-54a1a9cb3245","isPlace":true,"scene":"village","city":"bourgenbresse","category":"À voir","title":"Grotte de la Cabatane, crête et belvédère","date":null,"time":"","place":"Départ au parking du champ de foire (Treffort) ou Col des Engoulures, Val-Revermont","lat":46.26595,"lng":5.392077,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"Petite balade à la découverte de la grotte de la Cabatane et du magnifique belvédère sur Treffort.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/00/Grand_bassin_octogonal_Jardin_des_Tuileries_003.jpg/960px-Grand_bassin_octogonal_Jardin_des_Tuileries_003.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Moonik, CC BY-SA 3.0","photoGeneric":true},{"id":"dt-place-ff10cdfd-59c3-3c63-8a18-5bf372c1f4a1","isPlace":true,"scene":"expo","city":"bourgenbresse","category":"À voir","title":"Le Musée numérique","date":null,"time":"","place":"4 allée des Brotteaux, Bourg-en-Bresse","lat":46.208594,"lng":5.232206,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"un Musée Numérique, géré par la MJC Pop Corn.\r\nExplorez les œuvres de multiples musées.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Museum_of_the_History_of_Polish_Jews_in_Warsaw_Main_exhibition_Gwo%C5%BAdziec_synagogue.jpg/960px-Museum_of_the_History_of_Polish_Jews_in_Warsaw_Main_exhibition_Gwo%C5%BAdziec_synagogue.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Magdalena Starowieyska, Dariusz Golik, CC BY-SA 3.0 pl","photoGeneric":true},{"id":"dt-place-69e708dd-8faf-34f4-938e-5003150b0cc1","isPlace":true,"scene":"expo","city":"bourgenbresse","category":"À voir","title":"Le Moulin de Cézille","date":null,"time":"","place":"322 route de Foissiat, Jayat","lat":46.347401,"lng":5.130736,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"Le moulin de Cézille, dit \"moulin Gaud\", nous conte un pan important de l'histoire bressane, à travers sa machinerie et un petit musée créé par une équipe de passionnés.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e1/Entr%C3%A9e_Institut_de_France_23_quai_de_Conti.jpg/960px-Entr%C3%A9e_Institut_de_France_23_quai_de_Conti.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Jebulon, CC0","photoGeneric":true},{"id":"dt-place-890ef571-376b-39fe-88bc-9feacbda1509","isPlace":true,"scene":"village","city":"bourgenbresse","category":"À voir","title":"L'Abbaye","date":null,"time":"","place":"158 bis boulevard de Brou, Bourg-en-Bresse","lat":46.198429,"lng":5.234256,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"Restaurant sympa et souriant. Grande terrasse ombragée face au monastère royal de Brou.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/59/Bourg-en-Bresse_abbaye.jpeg/960px-Bourg-en-Bresse_abbaye.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-96c205cf-a2aa-35c8-a35a-562fa2af0045","isPlace":true,"scene":"village","city":"bourgenbresse","category":"À voir","title":"Site naturel \" La clairière des petits lapins\"","date":null,"time":"","place":"Rue de la Balme, Journans","lat":46.143084,"lng":5.330676,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"C'est un site naturel d’escalade et de motricité pour les enfants. Si le mur d’escalade est réservé aux groupes accompagnés de moniteurs agréés, l’aire de jeux est accessible à tous les enfants accompagnés d’un adulte.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Museum_of_the_History_of_Polish_Jews_in_Warsaw_Main_exhibition_Gwo%C5%BAdziec_synagogue.jpg/960px-Museum_of_the_History_of_Polish_Jews_in_Warsaw_Main_exhibition_Gwo%C5%BAdziec_synagogue.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Magdalena Starowieyska, Dariusz Golik, CC BY-SA 3.0 pl","photoGeneric":true},{"id":"dt-place-ad138189-9542-378a-9d39-b483b8374cf2","isPlace":true,"scene":"expo","city":"bourgenbresse","category":"À voir","title":"Musée du Revermont","date":null,"time":"","place":"40 rue Principale Cuisiat, Val-Revermont","lat":46.300387,"lng":5.388864,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"Au pied des premiers contreforts du Jura, au coeur du village de Cuisiat, le musée est installé dans l’ancienne mairie école et se caractérise par un jardin avec un potager-verger conservatoire où de nombreuses variétés sont conservées et/ou cultivées.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fd/Oxford_University_Museum_of_Natural_History%2C_Oxford%2C_UK_-_Diliff.jpg/960px-Oxford_University_Museum_of_Natural_History%2C_Oxford%2C_UK_-_Diliff.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Diliff, CC BY-SA 3.0","photoGeneric":true},{"id":"dt-place-bd924541-491c-3fb9-ba13-ae43faef5c71","isPlace":true,"scene":"village","city":"bourgenbresse","category":"À voir","title":"Moulin à huile des Bords de l'Ain","date":null,"time":"","place":"73, Rue du docteur Hubert, Neuville-sur-Ain","lat":46.078247,"lng":5.376627,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"Situé au centre du village de Neuville sur Ain entre les maisons classées, un moulin qui possède encore sa meule de pierre, entraînée autrefois par l'énergie de la rivière.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/15/Tour_Saint-Jacques_au_cr%C3%A9puscule.jpg/960px-Tour_Saint-Jacques_au_cr%C3%A9puscule.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Fabien Barrau, CC BY-SA 4.0","photoGeneric":true},{"id":"dt-place-8f3fb414-4d9c-3268-a18d-228ac551f149","isPlace":true,"scene":"expo","city":"bourgenbresse","category":"À voir","title":"Musée Louis Jourdan","date":null,"time":"","place":"Place Louis Jourdan, Saint-Paul-de-Varax","lat":46.098972,"lng":5.128919,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"Découvrez St Paul de Varax à travers les toiles du peintre paysagiste Louis Jourdan et quelques uns de ses effets personnels. Classé Musée de France, ce musée propose également la projection d'une vidéo sur la vie à St Paul en 1934 où apparait le peintre.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7d/Mus%C3%A9e_Jourdan_St_Paul_Varax_1.jpg/960px-Mus%C3%A9e_Jourdan_St_Paul_Varax_1.jpg?utm_source=fr.wikipedia.org&utm_campaign=api&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-8f7faea4-2ecc-3f91-aa6c-b394a5703f36","isPlace":true,"scene":"village","city":"bourgenbresse","category":"À voir","title":"Eglise de Saint-Germain-sur-renon","date":null,"time":"","place":"Le Village, Saint-Germain-sur-Renon","lat":46.080272,"lng":5.056523,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"Eglise d'origine romane, reconstruite en partie au XIXè, dont le porche (XIIè) est classé.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5f/%C3%89glise_Saint-Germain_de_Saint-Germain-sur-Renon_-_3.JPG/960px-%C3%89glise_Saint-Germain_de_Saint-Germain-sur-Renon_-_3.JPG?utm_source=fr.wikipedia.org&utm_campaign=api&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-927ad530-5ef8-39fd-ab6f-38823c889b18","isPlace":true,"scene":"marche","city":"bourgenbresse","category":"À voir","title":"Treffort médiéval, une traversée d'histoire","date":null,"time":"","place":"Le village, Val-Revermont","lat":46.270741,"lng":5.367808,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"En suivant les plaques signalétiques, vous traverserez l'histoire de ce village qui a conservé son aspect médiéval avec ses anciennes halles et ses élégantes maisons de vignerons.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fd/Oxford_University_Museum_of_Natural_History%2C_Oxford%2C_UK_-_Diliff.jpg/960px-Oxford_University_Museum_of_Natural_History%2C_Oxford%2C_UK_-_Diliff.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Diliff, CC BY-SA 3.0","photoGeneric":true},{"id":"dt-place-9394b8e3-0e1f-399b-b28a-d507cf5682e2","isPlace":true,"scene":"village","city":"bourgenbresse","category":"À voir","title":"Eglise St Maurice","date":null,"time":"","place":"Rue de l'église, Romans","lat":46.119659,"lng":5.022346,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"Elle fut construite au XII° siècle. \r\nA l'origine, elle était dédiée à Saint Martin, puis Saint Maurice, patron de Romans.\r\nSon clocher octogone fut démoli pendant la révolution : le clocher actuel date de 1857.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/05/%C3%89glise_Saint_Maurice_-_Romans_%28FR01%29_-_2025-07-06_-_1.jpg/960px-%C3%89glise_Saint_Maurice_-_Romans_%28FR01%29_-_2025-07-06_-_1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-1dbc3282-9e3c-374c-a61e-3c705cadf570","isPlace":true,"scene":"village","city":"bourgenbresse","category":"À voir","title":"Eglise Saint-Maurice","date":null,"time":"","place":"Place du Chapitre, Neuville-les-Dames","lat":46.162696,"lng":5.002886,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"Cette église du XIXe siècle de l'architecte Tony Ferret, s'inscrit dans son époque et dans le paysage local. Aujourd'hui encore la plus grande église du secteur, son style d'inspiration néo-romane lui confère une architecture harmonieuse.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/64/%C3%89glise_Saint_Maurice_-_Neuville-les-Dames_%28FR01%29_-_2025-07-05_-_5.jpg/960px-%C3%89glise_Saint_Maurice_-_Neuville-les-Dames_%28FR01%29_-_2025-07-05_-_5.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-42174967-e0d5-3eed-b303-a49717e020bb","isPlace":true,"scene":"village","city":"bourgenbresse","category":"À voir","title":"Eglise Saint Pierre","date":null,"time":"","place":"Le Village, Châtenay","lat":46.033789,"lng":5.200804,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"Eglise romane en partie détruite et reconstruite au XIXè, par l'architecte Tony Ferret, avec réemploi des anciens matériaux (châpiteaux corinthiens typique de la 2ème moitié du XIIè...).","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/%C3%89glise_St_Pierre_Ch%C3%A2tenay_Ain_6.jpg/960px-%C3%89glise_St_Pierre_Ch%C3%A2tenay_Ain_6.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-3c52dda0-7dfb-3911-b9be-322e7bb1345a","isPlace":true,"scene":"village","city":"bourgenbresse","category":"À voir","title":"Eglise Saint-Martin","date":null,"time":"","place":"Pla du Prieuré, Buellas","lat":46.209625,"lng":5.132848,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"Située sur un tertre naturel, cette église du XIIe s. domine la place du village. Évoquée dès l’An Mil. Ancienne possession de l’abbaye bénédictine de Tournus puis de l’archevêché de Lyon. Inscrite MH depuis le 9 juillet 1926.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b8/Buellas_%C3%A9glise_1201.jpg/960px-Buellas_%C3%A9glise_1201.jpg?utm_source=fr.wikipedia.org&utm_campaign=api&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-4459ddc6-9910-3838-8c62-6cc1f2e7b852","isPlace":true,"scene":"village","city":"bourgenbresse","category":"À voir","title":"Eglise de Saint-Martin-le-Châtel","date":null,"time":"","place":"Route de Montrevel, Saint-Martin-le-Châtel","lat":46.282151,"lng":5.116843,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"Eglise du XIXème siècle","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/15/%C3%89glise_St_Martin_Ch%C3%A2tel_22.jpg/960px-%C3%89glise_St_Martin_Ch%C3%A2tel_22.jpg?utm_source=fr.wikipedia.org&utm_campaign=api&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-26211e52-b46f-338d-a7ae-8dec70ca717f","isPlace":true,"scene":"village","city":"bourgenbresse","category":"À voir","title":"Eglise de Drom","date":null,"time":"","place":"Place Docteur Gaillard, Drom","lat":46.218302,"lng":5.367005,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"St Thyrse, dont les origines remontent au 12ème siècle (choeur du 15ème) ; le campanile date du 15ème et le presbytère du 18ème siècle.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2d/Abbaye_Fontenay_eglise_facade.jpg/960px-Abbaye_Fontenay_eglise_facade.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Myrabella, CC BY-SA 4.0","photoGeneric":true},{"id":"dt-place-32f99bc1-0b8c-3596-85be-d836042e3a6b","isPlace":true,"scene":"village","city":"bourgenbresse","category":"À voir","title":"Panorama du Mont Balvay","date":null,"time":"","place":"Balvay, Leyssard","lat":46.180544,"lng":5.469732,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"Surplombant la rivière d'Ain, ce site offre une vue imprenable. Vous découvrirez également  au sommet les ruines d'une ancienne forteresse.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fd/Oxford_University_Museum_of_Natural_History%2C_Oxford%2C_UK_-_Diliff.jpg/960px-Oxford_University_Museum_of_Natural_History%2C_Oxford%2C_UK_-_Diliff.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Diliff, CC BY-SA 3.0","photoGeneric":true},{"id":"dt-place-94a17b32-720e-335e-89f9-ff71445f2426","isPlace":true,"scene":"village","city":"bourgenbresse","category":"À voir","title":"Belvédère de Balvay","date":null,"time":"","place":"Balvay, Leyssard","lat":46.171703,"lng":5.472887,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"Depuis l'aire de décollage de parapente, la vue s'étend vers le sud sur la vallée de l'Ain puis à l'horizon jusqu'aux monts du lyonnais. Orienté plein ouest, cet endroit est idéal pour observer les couchers de soleil.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Museum_of_the_History_of_Polish_Jews_in_Warsaw_Main_exhibition_Gwo%C5%BAdziec_synagogue.jpg/960px-Museum_of_the_History_of_Polish_Jews_in_Warsaw_Main_exhibition_Gwo%C5%BAdziec_synagogue.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Magdalena Starowieyska, Dariusz Golik, CC BY-SA 3.0 pl","photoGeneric":true},{"id":"dt-place-44ec50c0-4dd8-36e2-8ef7-179780f65fe7","isPlace":true,"scene":"village","city":"bourgenbresse","category":"À voir","title":"Le village de Rignat et son église","date":null,"time":"","place":"Le village Rignat, Bohas-Meyriat-Rignat","lat":46.1428,"lng":5.357085,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"Depuis l'époque romaine, Rignat fut une terre de vignoble, mis à mal par le phylloxéra au XIXe siècle, puis par le mildiou. Ses maisons sont caractéristiques des villages viticoles du Revermont (escalier de pierre et palier extérieurs abritant la cave).","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/D%C3%BClmen%2C_Kreuzkapelle%2C_B%C3%A4nke_--_2021_--_7365.jpg/960px-D%C3%BClmen%2C_Kreuzkapelle%2C_B%C3%A4nke_--_2021_--_7365.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Dietmar Rabich, CC BY-SA 4.0","photoGeneric":true},{"id":"dt-place-df525eb6-3f39-3fd7-b24a-0114321070dc","isPlace":true,"scene":"village","city":"bourgenbresse","category":"À voir","title":"Parcours d'orientation \"Patrimoine adulte\" à la Grange du Pin","date":null,"time":"","place":"La Grange du Pin, Val-Revermont","lat":46.304992,"lng":5.356112,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"10 balises à trouver à l'aide d'une carte d'orientation, chacune associée à une \r\nquestion.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fd/Oxford_University_Museum_of_Natural_History%2C_Oxford%2C_UK_-_Diliff.jpg/960px-Oxford_University_Museum_of_Natural_History%2C_Oxford%2C_UK_-_Diliff.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Diliff, CC BY-SA 3.0","photoGeneric":true},{"id":"dt-place-b58d3bc9-49b8-39cf-b35d-823efa86d38c","isPlace":true,"scene":"village","city":"bourgenbresse","category":"À voir","title":"Circuit VTTAE 1 noir - Montfort / Mont-Myon - Espace Revermont Base FFvélo","date":null,"time":"","place":"La Grange du Pin, Val-Revermont","lat":46.305858,"lng":5.355334,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791513935190,"description":"Unique dans le paysage, un lieu mythique pour les habitants, le Myon-Mont se révèle extraordinaire par son paysage et la vue depuis son sommet surtout après la fameuse ascension du Z.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fd/Oxford_University_Museum_of_Natural_History%2C_Oxford%2C_UK_-_Diliff.jpg/960px-Oxford_University_Museum_of_Natural_History%2C_Oxford%2C_UK_-_Diliff.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Diliff, CC BY-SA 3.0","photoGeneric":true},{"id":"dt-place-