[{"id":"dt-place-451ec8fa-ebb9-3385-bed9-569636db4515","isPlace":true,"scene":"expo","city":"chateauroux","category":"À voir","title":"Musée et site historique de l'abbaye Notre-Dame de Déols","date":null,"time":"","place":"6 rue de l'Abbaye, Déols","lat":46.825802,"lng":1.7018049,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791341135179,"description":"Posée sur les bords de l'Indre, l'abbaye Notre-Dame fondée en 917 par Ebbes Le Noble est placée directement sous la protection du souverain pontife. Construite sur 4 siècles, elle est considérée aujourd’hui, comme la sœur de la prestigieuse abbaye de Cluny (en Saône et Loire).","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2c/D%C3%A9ols_-_Abbaye_Notre-Dame_-_08.jpg/960px-D%C3%A9ols_-_Abbaye_Notre-Dame_-_08.jpg?utm_source=fr.wikipedia.org&utm_campaign=api&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-db575a05-ed37-3717-bd17-1da682c739e2","isPlace":true,"scene":"village","city":"chateauroux","category":"À voir","title":"Forêt domaniale de Châteauroux","date":null,"time":"","place":"Office National des Forêts, Le Poinçonnet","lat":46.73878,"lng":1.72772,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791341135179,"description":"À deux pas de Châteauroux, la forêt domaniale offre une parenthèse au vert. À pied, à vélo ou simplement au fil des chemins, on y vient pour respirer, se balader et profiter d’un peu de nature.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/00/Grand_bassin_octogonal_Jardin_des_Tuileries_003.jpg/960px-Grand_bassin_octogonal_Jardin_des_Tuileries_003.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Moonik, CC BY-SA 3.0","photoGeneric":true},{"id":"dt-place-c980f5ff-27c8-387d-a24f-e94bf541850d","isPlace":true,"scene":"village","city":"chateauroux","category":"À voir","title":"Kyriad Châteauroux Saint-Maur","date":null,"time":