[{"id":"dt-place-1e08c50b-a12c-374a-8ea3-8d172759e1f5","isPlace":true,"scene":"village","city":"reims","category":"À voir","title":"Cathédrale Notre-Dame de Reims","date":null,"time":"","place":"Place du Cardinal Luçon, Reims","lat":49.2538649,"lng":4.0340161,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791168335537,"description":"Venez découvrir l'Ange au Sourire, la plus connue des 2 300 sculptures de la Cathédrale de Reims, classée au patrimoine mondial de l'UNESCO. Montez dans les Tours pour une vue imprenable sur la ville.\nL'Office de Tourisme de Reims propose des visites guidées.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/D%C3%BClmen%2C_Kreuzkapelle%2C_B%C3%A4nke_--_2021_--_7365.jpg/960px-D%C3%BClmen%2C_Kreuzkapelle%2C_B%C3%A4nke_--_2021_--_7365.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Dietmar Rabich, CC BY-SA 4.0","photoGeneric":true},{"id":"dt-place-26f89b23-6b62-3e16-931a-4d88d75806c2","isPlace":true,"scene":"expo","city":"reims","category":"À voir","title":"Visite guidée de la Cathédrale Notre Dame de Reims","date":null,"time":"","place":"Place du Cardinal Luçon, Reims","lat":49.2533241,"lng":4.0325757,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791168335537,"description":"L'Office de Tourisme de Reims propose des visites guidées vous permettant de visiter Reims, la cathédrale Notre-Dame, le palais du Tau, la basilique Saint-Remi, le musée Saint-Remi et/ou de faire un circuit sur la Reconstruction et l'Art déco (1920-1930)...","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/02/Reims_-_cath%C3%A9drale_Notre-Dame_-_2023-05-27_-_05.jpg/960px-Reims_-_cath%C3%A9drale_Notre-Dame_-_2023-05-27_-_05.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Wikimedia Commons"},{"id":"dt-place-3a78b99a-1566-3d8d-a8f2-39d14a05737b","isPlace":true,"scene":"village","city":"reims","category":"À voir","title":"Basilique Saint-Remi","date":null,"time":"","place":"Place Chanoine Ladame, Reims","lat":49.2143865,"lng":4.013725,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791168335537,"description":"Classée au patrimoine mondial de l'Unesco, cette basilique romano-gothique a été construite au XIème siècle pour abriter la sainte ampoule ainsi que les vestiges de saint Remi.","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/26/Dresden_Garnisonkirche_gp.jpg/960px-Dresden_Garnisonkirche_gp.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · User:Kolossos, CC BY-SA 3.0","photoGeneric":true},{"id":"dt-place-66029ad2-99b4-3fe7-91be-75ca9b31b1d9","isPlace":true,"scene":"village","city":"reims","category":"À voir","title":"Maison Fossier Reims Cathédrale","date":null,"time":"","place":"25 cours Jean-Baptiste Langlet, Reims","lat":49.2559158,"lng":4.0307324,"price":"Voir sur place","thumb":"","source":"datatourisme","createdAt":1791168335537,"description":"Biscuiterie au décor de bonbonnière spécialisée depuis 1756 dans les biscuits roses et les gourmandises. \nLe Biscuit Rose de Reims est l'un des emblèmes de la ville, ne passez pas à côté de cette gourmandise ! A découvrir également  : croquignoles, bouchons au marc et autres douceurs...","photo":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/D%C3%BClmen%2C_Kreuzkapelle%2C_B%C3%A4nke_--_2021_--_7365.jpg/960px-D%C3%BClmen%2C_Kreuzkapelle%2C_B%C3%A4nke_--_2021_--_7365.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","photoCredit":"Illustration · Dietmar Rabich, CC BY-SA 4.0","photoGeneric":true},{"id":"dt-place-f5ba305d-53f0-371d-9858-c05dc3a0a805","isPlace":true,"scene":"expo","city":"reims","category":"À voir","title":"Musée Saint-Remi","date":null,"time":"","place":"53 rue Simon, Reims","lat":49.243165,"lng":4.0402212,"price":"Voir sur place",